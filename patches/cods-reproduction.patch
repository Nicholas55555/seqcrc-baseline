+class _RunningSumList(list):
+    """List of per-image loss tensors that keeps their sum up to date in O(1) per update.
+
+    Reproduction patch (seqcrc-baseline/patches/cods-reproduction.patch, fix (b)): the optimizers recompute
+    sum(stack(losses)) over all n calibration images after every single-image update, which is
+    O(n) per candidate threshold and O(n^2) overall. The sum is kept in float64 here.
+    """
+
+    def __init__(self, *args):
+        super().__init__(*args)
+        self.total = float(sum(float(x) for x in self))
+
+    def append(self, x):
+        super().append(x)
+        self.total += float(x)
+
+    def __setitem__(self, i, x):
+        self.total += float(x) - float(self[i])
+        super().__setitem__(i, x)
+
+    def copy(self):
+        return _RunningSumList(self)
+
+
+def _fast_correct_risk(risk, n, B):
+    if isinstance(risk, _RunningSumList):
+        device = risk[0].device if len(risk) > 0 else "cpu"
+        return torch.tensor((risk.total + B) / (n + 1), dtype=torch.float32, device=device)
+    return None
+
+
